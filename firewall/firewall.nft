#!/usr/sbin/nft -f
# NetGuard Firewall Rules
# Load with: sudo nft -f firewall.nft
# Safety test: sudo nft -f firewall.nft; sleep 60; sudo nft flush ruleset

flush ruleset

table inet myfw {

    # ── Sets for dynamic blocking ──────────────────────────────────
    set blocklist_v4 {
        type ipv4_addr
        flags timeout
        comment "IPs blocked from the dashboard"
    }

    set blocklist_v6 {
        type ipv6_addr
        flags timeout
        comment "IPv6 IPs blocked from the dashboard"
    }

    # ── Rate-limit set for port-scan detection ─────────────────────
    set scan_detect {
        type ipv4_addr
        flags dynamic, timeout
        timeout 1m
    }

    # ── Input chain ────────────────────────────────────────────────
    chain input {
        type filter hook input priority 0; policy drop;

        # Loopback: always allow
        iif "lo" accept

        # Drop anything from the blocklist immediately
        ip  saddr @blocklist_v4 counter drop
        ip6 saddr @blocklist_v6 counter drop

        # Allow established / related traffic back in
        ct state established,related accept

        # Drop invalid packets silently
        ct state invalid counter drop

        # ICMP: allow ping with rate limit
        icmp  type echo-request limit rate 5/second accept
        icmpv6 type { echo-request, nd-neighbor-solicit, nd-router-advert, nd-neighbor-advert } accept

        # DHCPv4 client
        udp sport 67 udp dport 68 accept

        # ── Log everything else that will be dropped ───────────────
        # Rate-limited so logs don't explode under a flood
        limit rate 30/minute burst 10 packets \
            log prefix "FW-DROP-IN: " flags all counter
    }

    # ── Forward chain (default drop for non-routers) ───────────────
    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    # ── Output chain (allow everything outbound) ───────────────────
    chain output {
        type filter hook output priority 0; policy accept;
    }
}

